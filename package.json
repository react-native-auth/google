{
  "name": "@react-native-auth/google",
  "version": "0.0.0-beta.01",
  "description": "Modern React Native Authecation Library For Google OAuth2",
  "main": "./lib/module/GoogleAuth.js",
  "types": "./lib/typescript/src/GoogleAuth.d.ts",
  "exports": {
    ".": {
      "react-native-auth-google-source": "./src/GoogleAuth.tsx",
      "types": "./lib/typescript/src/GoogleAuth.d.ts",
      "default": "./lib/module/GoogleAuth.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace @react-native-auth/google-example",
    "clean": "del-cli android/build example/android/build example/android/.kotlin example/android/app/.cxx example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "typecheck": "tsc",
    "release": "release-it"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/react-native-auth/google.git"
  },
  "author": "channel101 <202932523+channel101@users.noreply.github.com> (https://github.com/channel101)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/react-native-auth/google/issues"
  },
  "homepage": "https://github.com/react-native-auth/google#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.86.2",
    "@release-it/conventional-changelog": "^12.0.0",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "prettier": "^3.9.10",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-builder-bob": "^0.43.1",
    "release-it": "^21.0.1",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.18.1",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "GoogleAuthSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "io.github.react_native_auth.google"
    }
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "release-it"
    ],
    "version": "0.63.1"
  }
}